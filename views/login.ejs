<section class="auth-section">
  <div class="auth-card">
    <h2>تسجيل الدخول</h2>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form action="/login" method="POST">
      <div class="form-group">
        <label for="email">البريد الإلكتروني</label>
        <input type="email" id="email" name="email" required placeholder="example@email.com">
      </div>
      <div class="form-group">
        <label for="password">كلمة المرور</label>
        <input type="password" id="password" name="password" required placeholder="كلمة المرور">
      </div>
      <button type="submit" class="btn btn-primary btn-full">دخول</button>
    </form>
    <p class="auth-switch">لسه معملتش حساب؟ <a href="/register">اشترك دلوقتي</a></p>
  </div>
</section>
