<section class="calc-section">
  <h1><%= t('cal_title') %></h1>
  <p class="subtitle"><%= t('cal_subtitle') %></p>

  <% if (error) { %>
    <div class="alert alert-error"><%= t(error) %></div>
  <% } %>

  <div class="calc-grid">
    <form action="/calories" method="POST" class="card calc-form">
      <div class="form-group">
        <label for="gender"><%= t('label_gender') %></label>
        <select id="gender" name="gender" required>
          <option value=""><%= t('opt_select') %></option>
          <option value="male" <%= old.gender === 'male' ? 'selected' : '' %>><%= t('opt_male') %></option>
          <option value="female" <%= old.gender === 'female' ? 'selected' : '' %>><%= t('opt_female') %></option>
        </select>
      </div>

      <div class="form-group">
        <label for="age"><%= t('label_age') %></label>
        <input type="number" id="age" name="age" min="10" max="100" required value="<%= old.age || '' %>">
      </div>

      <div class="form-group">
        <label for="weight"><%= t('label_weight') %></label>
        <input type="number" id="weight" name="weight" min="30" max="300" step="0.1" required value="<%= old.weight || '' %>">
      </div>

      <div class="form-group">
        <label for="height"><%= t('label_height') %></label>
        <input type="number" id="height" name="height" min="100" max="250" step="0.1" required value="<%= old.height || '' %>">
      </div>

      <div class="form-group">
        <label for="activity"><%= t('label_activity') %></label>
        <select id="activity" name="activity" required>
          <option value=""><%= t('opt_select') %></option>
          <option value="sedentary" <%= old.activity === 'sedentary' ? 'selected' : '' %>><%= t('opt_sedentary') %></option>
          <option value="light" <%= old.activity === 'light' ? 'selected' : '' %>><%= t('opt_light') %></option>
          <option value="moderate" <%= old.activity === 'moderate' ? 'selected' : '' %>><%= t('opt_moderate') %></option>
          <option value="active" <%= old.activity === 'active' ? 'selected' : '' %>><%= t('opt_active') %></option>
          <option value="very_active" <%= old.activity === 'very_active' ? 'selected' : '' %>><%= t('opt_very_active') %></option>
        </select>
      </div>

      <div class="form-group">
        <label for="goal"><%= t('label_goal') %></label>
        <select id="goal" name="goal" required>
          <option value=""><%= t('opt_select') %></option>
          <option value="lose" <%= old.goal === 'lose' ? 'selected' : '' %>><%= t('opt_lose') %></option>
          <option value="recomp" <%= old.goal === 'recomp' ? 'selected' : '' %>><%= t('opt_recomp') %></option>
          <option value="maintain" <%= old.goal === 'maintain' ? 'selected' : '' %>><%= t('opt_maintain') %></option>
          <option value="gain" <%= old.goal === 'gain' ? 'selected' : '' %>><%= t('opt_gain') %></option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary btn-full"><%= t('btn_calculate') %></button>
    </form>

    <% if (result) { %>
      <div class="card calc-result">
        <h2><%= t('result_title') %></h2>
        <div class="result-row">
          <span><%= t('result_bmr') %></span>
          <strong><%= result.bmr %> <%= t('unit_cal') %></strong>
        </div>
        <div class="result-row">
          <span><%= t('result_tdee') %></span>
          <strong><%= result.tdee %> <%= t('unit_cal') %></strong>
        </div>
        <div class="result-row highlight">
          <span><%= t('result_target') %></span>
          <strong><%= result.target_calories %> <%= t('unit_cal_day') %></strong>
        </div>

        <% if (result.goal === 'lose') { %>
          <hr>
          <h3><%= t('phase_title') %></h3>
          <div class="result-row">
            <span><%= t('phase1_label') %></span>
            <strong><%= result.phase1_calories %> <%= t('unit_cal_day') %></strong>
          </div>
          <p class="subtitle small"><%= t('phase1_desc') %></p>
          <div class="result-row">
            <span><%= t('phase2_label') %></span>
            <strong><%= result.phase2_calories %> <%= t('unit_cal_day') %></strong>
          </div>
          <p class="subtitle small"><%= t('phase2_desc') %></p>
        <% } else if (result.goal === 'recomp') { %>
          <hr>
          <h3><%= t('phase_title') %></h3>
          <p class="subtitle small"><%= t('recomp_desc') %></p>
        <% } %>

        <hr>
        <h3><%= t('result_macros_title') %></h3>
        <div class="stats-grid">
          <div class="stat-box">
            <span class="stat-value"><%= result.protein_g %> <%= t('unit_g') %></span>
            <span class="stat-label"><%= t('stat_protein') %></span>
          </div>
          <div class="stat-box">
            <span class="stat-value"><%= result.carbs_g %> <%= t('unit_g') %></span>
            <span class="stat-label"><%= t('stat_carbs') %></span>
          </div>
          <div class="stat-box">
            <span class="stat-value"><%= result.fat_g %> <%= t('unit_g') %></span>
            <span class="stat-label"><%= t('stat_fat') %></span>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</section>
