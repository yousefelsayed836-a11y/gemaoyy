<section class="calc-section">
  <h1>حاسبة السعرات اليومية 🔥</h1>
  <p class="subtitle">هات بياناتك وهنحسبلك احتياجك اليومي من السعرات والبروتين والكارب والدهون.</p>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <div class="calc-grid">
    <form action="/calories" method="POST" class="card calc-form">
      <div class="form-group">
        <label for="gender">الجنس</label>
        <select id="gender" name="gender" required>
          <option value="">اختر</option>
          <option value="male" <%= old.gender === 'male' ? 'selected' : '' %>>ذكر</option>
          <option value="female" <%= old.gender === 'female' ? 'selected' : '' %>>أنثى</option>
        </select>
      </div>

      <div class="form-group">
        <label for="age">السن (سنة)</label>
        <input type="number" id="age" name="age" min="10" max="100" required value="<%= old.age || '' %>">
      </div>

      <div class="form-group">
        <label for="weight">الوزن (كجم)</label>
        <input type="number" id="weight" name="weight" min="30" max="300" step="0.1" required value="<%= old.weight || '' %>">
      </div>

      <div class="form-group">
        <label for="height">الطول (سم)</label>
        <input type="number" id="height" name="height" min="100" max="250" step="0.1" required value="<%= old.height || '' %>">
      </div>

      <div class="form-group">
        <label for="activity">مستوى النشاط اليومي</label>
        <select id="activity" name="activity" required>
          <option value="">اختر</option>
          <option value="sedentary" <%= old.activity === 'sedentary' ? 'selected' : '' %>>قليل الحركة (عمل مكتبي - بدون رياضة)</option>
          <option value="light" <%= old.activity === 'light' ? 'selected' : '' %>>نشاط خفيف (تمرين 1-3 أيام أسبوعيًا)</option>
          <option value="moderate" <%= old.activity === 'moderate' ? 'selected' : '' %>>نشاط متوسط (تمرين 3-5 أيام أسبوعيًا)</option>
          <option value="active" <%= old.activity === 'active' ? 'selected' : '' %>>نشاط عالي (تمرين 6-7 أيام أسبوعيًا)</option>
          <option value="very_active" <%= old.activity === 'very_active' ? 'selected' : '' %>>نشاط مكثف جدًا (رياضي / مجهود بدني عالي)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="goal">الهدف</label>
        <select id="goal" name="goal" required>
          <option value="">اختر</option>
          <option value="lose" <%= old.goal === 'lose' ? 'selected' : '' %>>خسارة وزن (تنشيف)</option>
          <option value="maintain" <%= old.goal === 'maintain' ? 'selected' : '' %>>ثبات الوزن (المحافظة)</option>
          <option value="gain" <%= old.goal === 'gain' ? 'selected' : '' %>>زيادة وزن (تضخيم)</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary btn-full">احسب</button>
    </form>

    <% if (result) { %>
      <div class="card calc-result">
        <h2>نتيجتك</h2>
        <div class="result-row">
          <span>معدل الحرق الأساسي (BMR)</span>
          <strong><%= result.bmr %> سعر</strong>
        </div>
        <div class="result-row">
          <span>السعرات الكلية مع النشاط (TDEE)</span>
          <strong><%= result.tdee %> سعر</strong>
        </div>
        <div class="result-row highlight">
          <span>السعرات المطلوبة لهدفك</span>
          <strong><%= result.target_calories %> سعر / يوم</strong>
        </div>
        <hr>
        <h3>توزيع الماكروز اليومي</h3>
        <div class="stats-grid">
          <div class="stat-box">
            <span class="stat-value"><%= result.protein_g %> جم</span>
            <span class="stat-label">بروتين</span>
          </div>
          <div class="stat-box">
            <span class="stat-value"><%= result.carbs_g %> جم</span>
            <span class="stat-label">كاربوهيدرات</span>
          </div>
          <div class="stat-box">
            <span class="stat-value"><%= result.fat_g %> جم</span>
            <span class="stat-label">دهون</span>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</section>
