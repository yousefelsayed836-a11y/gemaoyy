<section class="auth-section">
  <div class="auth-card">
    <h2><%= t('register_title') %></h2>
    <% if (error) { %>
      <div class="alert alert-error"><%= t(error) %></div>
    <% } %>
    <form action="/register" method="POST">
      <div class="form-group">
        <label for="name"><%= t('label_name') %></label>
        <input type="text" id="name" name="name" required placeholder="<%= t('placeholder_name') %>">
      </div>
      <div class="form-group">
        <label for="email"><%= t('label_email') %></label>
        <input type="email" id="email" name="email" required placeholder="<%= t('placeholder_email') %>">
      </div>
      <div class="form-group">
        <label for="password"><%= t('label_password') %></label>
        <input type="password" id="password" name="password" required placeholder="<%= t('placeholder_password') %>">
      </div>
      <div class="form-group">
        <label for="password2"><%= t('label_password2') %></label>
        <input type="password" id="password2" name="password2" required placeholder="<%= t('placeholder_password2') %>">
      </div>
      <button type="submit" class="btn btn-primary btn-full"><%= t('btn_create_account') %></button>
    </form>
    <p class="auth-switch"><%= t('register_switch') %> <a href="/login"><%= t('register_switch_link') %></a></p>
  </div>
</section>
