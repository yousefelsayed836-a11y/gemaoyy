<section class="auth-section">
  <div class="auth-card">
    <h2>إنشاء حساب جديد</h2>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form action="/register" method="POST">
      <div class="form-group">
        <label for="name">الاسم</label>
        <input type="text" id="name" name="name" required placeholder="اسمك">
      </div>
      <div class="form-group">
        <label for="email">البريد الإلكتروني</label>
        <input type="email" id="email" name="email" required placeholder="example@email.com">
      </div>
      <div class="form-group">
        <label for="password">كلمة المرور</label>
        <input type="password" id="password" name="password" required placeholder="6 أحرف على الأقل">
      </div>
      <div class="form-group">
        <label for="password2">تأكيد كلمة المرور</label>
        <input type="password" id="password2" name="password2" required placeholder="أعد كتابة كلمة المرور">
      </div>
      <button type="submit" class="btn btn-primary btn-full">إنشاء الحساب</button>
    </form>
    <p class="auth-switch">عندك حساب؟ <a href="/login">سجل دخولك</a></p>
  </div>
</section>
