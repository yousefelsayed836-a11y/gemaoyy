<section class="dashboard">
  <h1><%= t('dash_welcome') %> <%= userName %> 👋</h1>

  <% if (profile) { %>
    <div class="card">
      <h2><%= t('dash_summary_title') %></h2>
      <div class="stats-grid">
        <div class="stat-box">
          <span class="stat-value"><%= profile.target_calories %></span>
          <span class="stat-label"><%= t('stat_calories') %></span>
        </div>
        <div class="stat-box">
          <span class="stat-value"><%= profile.protein_g %> <%= t('unit_g') %></span>
          <span class="stat-label"><%= t('stat_protein') %></span>
        </div>
        <div class="stat-box">
          <span class="stat-value"><%= profile.carbs_g %> <%= t('unit_g') %></span>
          <span class="stat-label"><%= t('stat_carbs') %></span>
        </div>
        <div class="stat-box">
          <span class="stat-value"><%= profile.fat_g %> <%= t('unit_g') %></span>
          <span class="stat-label"><%= t('stat_fat') %></span>
        </div>
      </div>
      <a href="/calories" class="btn btn-outline"><%= t('dash_edit_data') %></a>
    </div>
  <% } else { %>
    <div class="card">
      <h2><%= t('dash_no_data_title') %></h2>
      <p><%= t('dash_no_data_desc') %></p>
      <a href="/calories" class="btn btn-primary"><%= t('dash_calc_now') %></a>
    </div>
  <% } %>

  <div class="card">
    <h2><%= t('dash_foods_title') %></h2>
    <p><%= t('dash_foods_desc') %></p>
    <a href="/foods" class="btn btn-primary"><%= t('dash_foods_btn') %></a>
  </div>

  <div class="card">
    <h2><%= t('dash_bodyshape_title') %></h2>
    <p><%= t('dash_bodyshape_desc') %></p>
    <a href="/body-shape" class="btn btn-primary"><%= t('dash_bodyshape_btn') %></a>
  </div>

  <div class="card">
    <h2><%= t('ex_title') %></h2>
    <p><%= t('ex_subtitle') %></p>
    <a href="/exercises" class="btn btn-primary"><%= t('nav_exercises') %></a>
  </div>
</section>
