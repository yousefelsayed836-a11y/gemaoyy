<section class="hero">
  <div class="hero-text">
    <h1><%= t('home_title') %></h1>
    <p><%- t('home_subtitle') %></p>
    <% if (!isLoggedIn) { %>
      <div class="hero-actions">
        <a href="/register" class="btn btn-primary"><%= t('home_signup') %></a>
        <a href="/login" class="btn btn-outline"><%= t('home_login') %></a>
      </div>
    <% } else { %>
      <div class="hero-actions">
        <a href="/calories" class="btn btn-primary"><%= t('home_calc_now') %></a>
        <a href="/foods" class="btn btn-outline"><%= t('home_foods') %></a>
      </div>
    <% } %>
  </div>
</section>

<section class="features">
  <div class="feature-card">
    <div class="feature-icon">📊</div>
    <h3><%= t('feature1_title') %></h3>
    <p><%= t('feature1_desc') %></p>
  </div>
  <div class="feature-card">
    <div class="feature-icon">🍗</div>
    <h3><%= t('feature2_title') %></h3>
    <p><%= t('feature2_desc') %></p>
  </div>
  <div class="feature-card">
    <div class="feature-icon">🔒</div>
    <h3><%= t('feature3_title') %></h3>
    <p><%= t('feature3_desc') %></p>
  </div>
  <div class="feature-card">
    <div class="feature-icon">🧍</div>
    <h3><%= t('feature4_title') %></h3>
    <p><%= t('feature4_desc') %></p>
    <a href="/body-shape" class="btn btn-outline feature-btn"><%= t('nav_bodyshape') %></a>
  </div>
</section>
