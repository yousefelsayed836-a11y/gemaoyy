<section class="calc-section">
  <h1><%= t('bodyshape_title') %></h1>
  <p class="subtitle"><%= t('bodyshape_subtitle') %></p>

  <% if (error) { %>
    <div class="alert alert-error"><%= t(error) %></div>
  <% } %>

  <div class="calc-grid">
    <form action="/body-shape" method="POST" class="card calc-form">
      <div class="form-group">
        <label for="gender"><%= t('label_gender') %></label>
        <select id="gender" name="gender" required>
          <option value=""><%= t('opt_select') %></option>
          <option value="male" <%= old.gender === 'male' ? 'selected' : '' %>><%= t('opt_male') %></option>
          <option value="female" <%= old.gender === 'female' ? 'selected' : '' %>><%= t('opt_female') %></option>
        </select>
      </div>

      <div class="form-group">
        <label for="height"><%= t('label_height') %></label>
        <input type="number" id="height" name="height" min="100" max="250" step="0.1" required value="<%= old.height || '' %>">
      </div>

      <div class="form-group">
        <label for="weight"><%= t('label_weight') %></label>
        <input type="number" id="weight" name="weight" min="30" max="300" step="0.1" required value="<%= old.weight || '' %>">
      </div>

      <div class="form-group">
        <label for="chest"><%= t('label_chest') %></label>
        <input type="number" id="chest" name="chest" min="40" max="200" step="0.1" required value="<%= old.chest || '' %>">
      </div>

      <div class="form-group">
        <label for="waist"><%= t('label_waist') %></label>
        <input type="number" id="waist" name="waist" min="40" max="200" step="0.1" required value="<%= old.waist || '' %>">
      </div>

      <div class="form-group">
        <label for="hips"><%= t('label_hips') %></label>
        <input type="number" id="hips" name="hips" min="40" max="200" step="0.1" required value="<%= old.hips || '' %>">
      </div>

      <div class="form-group">
        <label for="thigh"><%= t('label_thigh') %></label>
        <input type="number" id="thigh" name="thigh" min="20" max="120" step="0.1" required value="<%= old.thigh || '' %>">
      </div>

      <div class="form-group">
        <label for="arm"><%= t('label_arm') %></label>
        <input type="number" id="arm" name="arm" min="10" max="80" step="0.1" required value="<%= old.arm || '' %>">
      </div>

      <button type="submit" class="btn btn-primary btn-full"><%= t('btn_calculate') %></button>
    </form>

    <% if (result) { %>
      <div class="card calc-result bodyshape-result">
        <h2><%= t('bodyshape_result_title') %></h2>
        <div class="body-svg-wrap">
          <%- svg %>
        </div>
        <div class="result-row highlight">
          <span><%= t('bodyshape_bodyfat') %></span>
          <strong><%= result.body_fat %>%</strong>
        </div>
        <p class="subtitle small"><%= t('bodyshape_disclaimer') %></p>
      </div>
    <% } %>
  </div>
</section>
